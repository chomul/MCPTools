{"designDocPath":"Assets/Docs/\uae30\ud68d\uae30\ubcf8\uad6c\uc870.md","scanRootPath":"Assets","createdAt":"2026-07-21 04:55","items":[{"id":"item_001","name":"\uc6b0\ub85c\ubcf4\ub85c\uc2a4 \uba38\ub9ac \ucf54\uc5b4","description":"\ud50c\ub808\uc774\uc5b4\uac00 \uc870\uc791\ud558\ub294 \uc790\uac00 \uc99d\uc2dd \uc0dd\uccb4 \ubcd1\uae30 '\uc6b0\ub85c\ubcf4\ub85c\uc2a4'\uc758 \uba38\ub9ac \ucf54\uc5b4 \uc2a4\ud504\ub77c\uc774\ud2b8. \ubd95\uad34\ud55c \uc0dd\uccb4 \ub124\ud2b8\uc6cc\ud06c \uc138\uacc4\uad00\uc5d0 \ub9de\ub294 \uc720\uae30\uccb4+\uae30\uacc4 \uc735\ud569 \ub514\uc790\uc778, \ud0d1\ub2e4\uc6b4 2D \ubdf0, \uc9c4\ud589 \ubc29\ud5a5\uc774 \uba85\ud655\ud55c \uc2e4\ub8e8\uc5e3. \uc5b4\ub450\uc6b4 \ubc30\uacbd \uc704\uc5d0\uc11c \uc798 \uc77d\ud788\ub294 \ubc1c\uad11 \ucf54\uc5b4 \ud3ec\uc778\ud2b8. \ud22c\uba85 \ubc30\uacbd PNG.","assetType":"image","targetPrefabPath":"","targetObjectPath":"","isUI":false,"isUISpecified":true,"status":"\ub300\uc0c1 \ubbf8\uc815"},{"id":"item_002","name":"\ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8 \uae30\ubcf8","description":"\uba38\ub9ac \uacbd\ub85c\ub97c \ub530\ub77c\uc624\ub294 \ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8\uc758 \uae30\ubcf8 \uc2a4\ud504\ub77c\uc774\ud2b8. \uc0dd\uccb4 \ubcd1\uae30\uc758 \ub9c8\ub514(\ucc99\ucd94/\uc678\uace8\uaca9) \ub290\ub08c, \uc6d0\ud615\uc5d0 \uac00\uae4c\uc6b4 \ud615\ud0dc\ub85c \uccb4\uc778 \uc5f0\uacb0 \uc2dc \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc774\uc5b4\uc9c0\ub294 \ub514\uc790\uc778. \uc5ed\ud560 \ubb38\uc591\uc774 \uc704\uc5d0 \uc5b9\ud790 \uc218 \uc788\uac8c \uc911\uc559\uc774 \ube44\uad50\uc801 \ub2e8\uc21c\ud574\uc57c \ud568. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Body/BodySegment.prefab","targetObjectPath":"BodySegment","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_003","name":"\uc2e4\ub4dc \uc5ed\ud560 \uc138\uadf8\uba3c\ud2b8","description":"\uc2e4\ub4dc \uc5ed\ud560 \ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8 \uc2a4\ud504\ub77c\uc774\ud2b8. \uae30\ubcf8 \uc138\uadf8\uba3c\ud2b8\uc640 \uc2e4\ub8e8\uc5e3\u00b7\ubb38\uc591\uc73c\ub85c \uad6c\ubd84(\uc0c9\ub9cc\uc73c\ub85c \uad6c\ubd84 \uae08\uc9c0 \uaddc\uce59). \ubc29\ud328/\uc721\uac01 \uac11\uac01 \ubb38\uc591, \ud478\ub978 \uacc4\uc5f4 \ubc1c\uad11. \ucda9\uc804/\ubc29\uc804 \uc0c1\ud0dc \ud45c\ud604\uc744 \uc704\ud574 \ubb38\uc591\uc774 \uba85\ud655\ud574\uc57c \ud568.","assetType":"image","targetPrefabPath":"","targetObjectPath":"","isUI":false,"isUISpecified":true,"status":"\ub300\uc0c1 \ubbf8\uc815"},{"id":"item_004","name":"\uacf5\uaca9 \uc5ed\ud560 \uc138\uadf8\uba3c\ud2b8","description":"\uacf5\uaca9 \uc5ed\ud560 \ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8 \uc2a4\ud504\ub77c\uc774\ud2b8. \ucd1d\uad6c/\uac00\uc2dc \ub3cc\uae30\uac00 \uc788\ub294 \uc2e4\ub8e8\uc5e3\uc73c\ub85c \ubc1c\uc0ac \ubc29\ud5a5\uc744 \ud45c\ud604. \ubd89\uc740/\uc8fc\ud669 \uacc4\uc5f4 \ud3ec\uc778\ud2b8, \uae30\ubcf8 \uc138\uadf8\uba3c\ud2b8\uc640 \ud615\ud0dc\ub85c \uad6c\ubd84\ub418\ub294 \ub514\uc790\uc778.","assetType":"image","targetPrefabPath":"","targetObjectPath":"","isUI":false,"isUISpecified":true,"status":"\ub300\uc0c1 \ubbf8\uc815"},{"id":"item_005","name":"\ub808\uc774\uc800 \uc5ed\ud560 \uc138\uadf8\uba3c\ud2b8","description":"\ub808\uc774\uc800 \uc5ed\ud560 \ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8 \uc2a4\ud504\ub77c\uc774\ud2b8. \ub80c\uc988/\ud504\ub9ac\uc998 \ud615\ud0dc\uc758 \ubc1c\uc0ac\uad6c\uac00 \uc788\ub294 \uc2e4\ub8e8\uc5e3, \ubcf4\ub77c/\uc2dc\uc548 \uacc4\uc5f4 \ubc1c\uad11 \ucf54\uc5b4. \uc608\uace0\uc120-\uad11\uc120 \ubc1c\uc0ac \uc5f0\ucd9c\uacfc \uc5b4\uc6b8\ub9ac\ub294 \ub514\uc790\uc778.","assetType":"image","targetPrefabPath":"","targetObjectPath":"","isUI":false,"isUISpecified":true,"status":"\ub300\uc0c1 \ubbf8\uc815"},{"id":"item_006","name":"\uc81c\uc5b4 \uc5ed\ud560 \uc138\uadf8\uba3c\ud2b8","description":"\uc81c\uc5b4 \uc5ed\ud560 \ubab8\ud1b5 \uc138\uadf8\uba3c\ud2b8 \uc2a4\ud504\ub77c\uc774\ud2b8. \ucd09\uc218/\uc548\ud14c\ub098 \ud615\ud0dc\uc758 \uc2e4\ub8e8\uc5e3\uc73c\ub85c \uad6c\uc18d\u00b7\uc81c\uc5b4 \uae30\ub2a5\uc744 \ud45c\ud604. \ub179\uc0c9/\ud669\ub85d \uacc4\uc5f4 \ud3ec\uc778\ud2b8, \ub2e4\ub978 \uc138 \uc5ed\ud560\uacfc \ubb38\uc591\u00b7\ud615\ud0dc\ub85c \uba85\ud655\ud788 \uad6c\ubd84.","assetType":"image","targetPrefabPath":"","targetObjectPath":"","isUI":false,"isUISpecified":true,"status":"\ub300\uc0c1 \ubbf8\uc815"},{"id":"item_007","name":"\ud3ec\uc704 \ud3ed\ubc1c \uc774\ud399\ud2b8","description":"\ubab8\ud1b5 \uc18c\ube44\ud615 \ud3ec\uc704 \ud3ed\ubc1c\uc758 \ud3ed\ubc1c \uc2a4\ud504\ub77c\uc774\ud2b8(\ubc18\uacbd 1.8 \uc6d0\ud615 \ubc94\uc704). ExplosionBlast \ud504\ub9ac\ud339\uc758 SpriteRenderer\uc5d0 \uc801\uc6a9. \uc0dd\uccb4 \uc5d0\ub108\uc9c0 \ubc29\ucd9c \ub290\ub08c\uc758 \uac15\ub82c\ud55c \uc6d0\ud615 \ud3ed\ubc1c, \uc8fc\ud669/\uc801\uc0c9 \ubc1c\uad11, \uc911\uc2ec\uc5d0\uc11c \ud37c\uc9c0\ub294 \ubc29\uc0ac\ud615 \uad6c\uc870. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/ExplosionBlast.prefab","targetObjectPath":"ExplosionBlast","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_008","name":"\ud3ed\ubc1c \uc608\uace0 \ud45c\uc2dc","description":"\ud3ed\ubc1c \uc608\uace0 0.25\ucd08 \ub3d9\uc548 \uc18c\ube44\ub420 \uc138\uadf8\uba3c\ud2b8 \uc704\uce58\uc5d0 \ud45c\uc2dc\ub418\ub294 \uc6d0\ud615 \uc608\uace0 \uc2a4\ud504\ub77c\uc774\ud2b8. \ubc18\ud22c\uba85 \uacbd\uace0 \ub9c1 \ud615\ud0dc, \ubd89\uc740 \uacc4\uc5f4 \uc678\uacfd\uc120\uacfc \ub0ae\uc740 \ucc44\ub3c4\uc758 \ub0b4\ubd80 \ucc44\uc6c0. \uc608\uace0\uc640 \uc2e4\uc81c \ubc94\uc704\uac00 \uc77c\uce58\ud574\uc57c \ud558\ubbc0\ub85c \uc815\ud655\ud55c \uc6d0\ud615.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/ExplosionTelegraph.prefab","targetObjectPath":"ExplosionTelegraph","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_009","name":"\ub808\uc774\uc800 \uad11\uc120","description":"\ub808\uc774\uc800 \uc5ed\ud560\uc758 \uad00\ud1b5 \uad11\uc120 \uc2a4\ud504\ub77c\uc774\ud2b8(\ud3ed 0.35, \uae38\uc774 7 \ube44\uc728\uc758 \uac00\ub85c \ube54). LaserBeam \ud504\ub9ac\ud339\uc5d0 \uc801\uc6a9. \uc911\uc2ec\uc774 \ubc1d\uace0 \uac00\uc7a5\uc790\ub9ac\uac00 \ubc1c\uad11 \uadf8\ub77c\ub370\uc774\uc158\uc778 \uc5d0\ub108\uc9c0 \ube54, \uc2dc\uc548/\ubcf4\ub77c \uacc4\uc5f4. 9-slice \ub610\ub294 \uac00\ub85c \ud0c0\uc77c\ub9c1 \uac00\ub2a5\ud55c \uad6c\uc870.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/LaserBeam.prefab","targetObjectPath":"LaserBeam","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_010","name":"\ub808\uc774\uc800 \uc608\uace0\uc120","description":"\ub808\uc774\uc800 \ubc1c\uc0ac 0.2\ucd08 \uc804 \ud45c\uc2dc\ub418\ub294 \uc9c1\uc120 \uc608\uace0\uc120 \uc2a4\ud504\ub77c\uc774\ud2b8. \uc2e4\uc81c \uad11\uc120\uacfc \uac19\uc740 \ud3ed\u00b7\uae38\uc774 \ube44\uc728\uc758 \uc587\uc740 \ubc18\ud22c\uba85 \ub77c\uc778, \uc810\uba78/\uacbd\uace0 \ub290\ub08c\uc758 \ubd89\uc740 \ub610\ub294 \ubc1d\uc740 \uc2dc\uc548 \uc678\uacfd\uc120. \ud53c\ud574\uc120\uacfc \uc2dc\uac01\uc801\uc73c\ub85c \uad6c\ubd84\ub418\ub418 \uc704\uce58\uac00 \uc77c\uce58.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/LaserTelegraph.prefab","targetObjectPath":"LaserTelegraph","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_011","name":"\uc2e4\ub4dc \ubc29\uc5b4 \uc12c\uad11 \uc774\ud399\ud2b8","description":"\uc2e4\ub4dc\uac00 \ud53c\uaca9 1\uac74\uc744 \ubb34\ud6a8\ud654\ud560 \ub54c \uc7ac\uc0dd\ub418\ub294 \ucda9\uaca9 \uc12c\uad11 \uc2a4\ud504\ub77c\uc774\ud2b8. ShieldBlockEffect \ud504\ub9ac\ud339\uc5d0 \uc801\uc6a9. \uc721\uac01/\uc6d0\ud615 \ubc30\ub9ac\uc5b4\uac00 \uc21c\uac04 \ube5b\ub098\ub294 \uc784\ud329\ud2b8, \ud478\ub978 \ubc1c\uad11, \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/ShieldBlockEffect.prefab","targetObjectPath":"ShieldBlockEffect","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_012","name":"\uc2e4\ub4dc \ubc94\uc704 \ub9c1","description":"\uc2e4\ub4dc \uc138\uadf8\uba3c\ud2b8\uc758 \ubcf4\ud638 \ubc18\uacbd(1.5)\uc744 \ub098\ud0c0\ub0b4\ub294 \ubc94\uc704 \ub9c1 \uc2a4\ud504\ub77c\uc774\ud2b8. ShieldMask \ud504\ub9ac\ud339\uc5d0 \uc801\uc6a9. \uc587\uc740 \ubc1c\uad11 \uc6d0\ud615 \ub9c1\uacfc \uc605\uc740 \ub0b4\ubd80 \ucc44\uc6c0, \ud478\ub978 \uacc4\uc5f4, \ucda9\uc804 \uc0c1\ud0dc\ub97c \ud45c\ud604\ud558\ub294 \uc740\uc740\ud55c \ubb38\uc591. \ubc18\ud22c\uba85 PNG.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/BodyRoles/ShieldMask.prefab","targetObjectPath":"ShieldMask","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_013","name":"\ubcf4\uc2a4 \uac10\uc5fc\uccb4","description":"10\ubd84 \ub9c8\uc77c\uc2a4\ud1a4\uc5d0 \ub4f1\uc7a5\ud558\ub294 \ub300\ud615 \ubcf4\uc2a4 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \uad70\uc9d1 \uac10\uc5fc\uccb4\uc758 \uc815\uc810, \uac70\ub300\ud558\uace0 \uc704\uc555\uc801\uc778 \uc0dd\uccb4 \uad34\ubb3c, \ub2e4\ub978 \uc801\uacfc \uba85\ud655\ud788 \uad6c\ubd84\ub418\ub294 \ud06c\uae30\uac10\uacfc \ub514\ud14c\uc77c. \uc5b4\ub450\uc6b4 \ud544\ub4dc\uc5d0\uc11c \uc2e4\ub8e8\uc5e3\uc774 \uc77d\ud788\ub294 \ub514\uc790\uc778. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemyBoss.prefab","targetObjectPath":"EnemyBoss","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_014","name":"\ub3cc\uc9c4\ud615 \uc801 (Charger)","description":"\ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3cc\uc9c4\ud558\ub294 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \ubfb0\uc871\ud55c \uc804\ubc29 \uc2e4\ub8e8\uc5e3\uc73c\ub85c \ub3cc\uc9c4 \ubc29\ud5a5\uc131\uc744 \ud45c\ud604, \uacf5\uaca9\uc801\uc778 \ud615\ud0dc. \uad70\uc9d1\uc73c\ub85c \ub4f1\uc7a5\ud574\ub3c4 \ud310\ub3c5\uc131\uc774 \uc720\uc9c0\ub418\ub294 \ub2e8\uc21c\ud55c \uc2e4\ub8e8\uc5e3. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemyCharger.prefab","targetObjectPath":"EnemyCharger","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_015","name":"\ucd94\uc801\ud615 \uc801 (Chaser)","description":"\ud50c\ub808\uc774\uc5b4\ub97c \uc9c0\uc18d \ucd94\uc801\ud558\ub294 \uae30\ubcf8 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \uac00\uc7a5 \ud754\ud558\uac8c \ub4f1\uc7a5\ud558\ub294 \uc7a1\ubab9\uc73c\ub85c \ub2e8\uc21c\ud558\uace0 \ud310\ub3c5\uc131 \ub192\uc740 \uc720\uae30\uccb4 \uc2e4\ub8e8\uc5e3. 180\ub9c8\ub9ac \ub3d9\uc2dc \ud45c\uc2dc\ub97c \uace0\ub824\ud55c \uc800\ub514\ud14c\uc77c \ub514\uc790\uc778. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemyChaser.prefab","targetObjectPath":"EnemyChaser","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_016","name":"\uc815\uc608 \uac10\uc5fc\uccb4 (Elite)","description":"\uc77c\ubc18 \uc801\ubcf4\ub2e4 \uac15\ud55c \uc815\uc608 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \uc77c\ubc18 \uc801 \ub300\ube44 \ud06c\uace0 \uc7a5\uac11/\ub3cc\uae30 \ub4f1 \uac15\ud654\ub41c \uc678\ud615, \uc815\uc608\uc784\uc744 \ud55c\ub208\uc5d0 \uc54c \uc218 \uc788\ub294 \ucc28\ubcc4\ud654\ub41c \uc2e4\ub8e8\uc5e3. \uc81c\uc5b4 \uc800\ud56d(0.5\ucd08) \ub4f1 \ud2b9\uc218 \uaddc\uce59 \ub300\uc0c1. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemyElite.prefab","targetObjectPath":"EnemyElite","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_017","name":"\uc6d0\uac70\ub9ac\ud615 \uc801 (Shooter)","description":"\uc6d0\uac70\ub9ac\uc5d0\uc11c \ud22c\uc0ac\uccb4\ub97c \ubc1c\uc0ac\ud558\ub294 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \ubc1c\uc0ac \uae30\uad00(\ud3ec\uc790 \uc8fc\uba38\ub2c8/\ucd09\uc218 \ud3ec)\uc774 \ubcf4\uc774\ub294 \uc2e4\ub8e8\uc5e3\uc73c\ub85c \uc6d0\uac70\ub9ac \uc704\ud611\uc784\uc744 \uc804\ub2ec. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemyShooter.prefab","targetObjectPath":"EnemyShooter","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_018","name":"\ubd84\uc5f4\ud615 \uc801 (Splitter)","description":"\uc0ac\ub9dd \uc2dc \ubd84\uc5f4\ud558\ub294 \uac10\uc5fc\uccb4 \uc2a4\ud504\ub77c\uc774\ud2b8. \uc5ec\ub7ec \uac1c\uccb4\uac00 \ubb49\uccd0 \uc788\ub294 \ub4ef\ud55c \uc138\ud3ec \ub369\uc5b4\ub9ac \uc2e4\ub8e8\uc5e3\uc73c\ub85c \ubd84\uc5f4 \ud2b9\uc131\uc744 \uc554\uc2dc. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Enemies/EnemySplitter.prefab","targetObjectPath":"EnemySplitter","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_019","name":"\ubab8\ud1b5 \uc870\uac01 \ud53d\uc5c5","description":"\uc801 \ucc98\uce58 \uc2dc \ub4dc\ub86d\ub418\ub294 \ubab8\ud1b5 \uc870\uac01 \ud53d\uc5c5 \uc2a4\ud504\ub77c\uc774\ud2b8(12\uac1c\ub2f9 \ubab8\ud1b5 \uc0dd\uc131 \uc694\uccad 1\uac1c). \uc0dd\uccb4 \uc870\uc9c1 \uc870\uac01/\uc720\uc804\uc790 \ucea1\uc290 \ub290\ub08c, \ud544\ub4dc\uc5d0\uc11c \ub208\uc5d0 \ub744\ub294 \ubc1c\uad11 \ud3ec\uc778\ud2b8. \uacbd\ud5d8\uce58\u00b7\ud68c\ubcf5\uacfc \uc0c9\u00b7\ud615\ud0dc\ub85c \uad6c\ubd84. \ud22c\uba85 \ubc30\uacbd.","assetType":"image","targetPrefabPath":"Assets/OUROBOROS/Prefabs/Pickups/PickupBodyFragment.prefab","targetObjectPath":"PickupBodyFragment","isUI":false,"isUISpecified":true,"status":"pending"},{"id":"item_020","name":"\uacbd\ud5d8\uce58 \ud53d\uc5c5","description":"\uc801 \ucc98\uce58 \uc2dc \ub4dc\ub86d\ub418\ub294 \uacbd\ud5d8\uce58 \ud53d\uc5c5 \uc2a4\ud504\ub77c\uc774\ud2b8. \uc791\uc740 \ubc1c\uad11 \uacb0\uc815/\uc5d0\ub108\uc9c0 \uad6c\uc2ac \ud615\ud0dc, \ub300\ub7c9\uc73c\ub85c \uae54\ub824\ub3c4 \uc2dc\uac01\uc801 \uc18c\uc74c\uc774 \uc801\